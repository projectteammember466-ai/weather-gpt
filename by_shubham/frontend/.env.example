# Google Gemini API Key (Required for AI chat & function calling)
VITE_GEMINI_API_KEY=

# OpenWeather API Key (Optional - real-time Open-Meteo observations used if omitted)
VITE_OPENWEATHER_API_KEY=

# Google Maps API Key (Powers roadmap, satellite hybrid, and terrain layers on the radar map)
VITE_GOOGLE_MAPS_API_KEY=
